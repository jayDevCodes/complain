PORT=5001

# Optional parallel AI providers. Leave blank to disable a provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-reasoner
DEEPSEEK_BASE_URL=https://api.deepseek.com

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Optional source-search provider. Configure one.
TAVILY_API_KEY=
SERPER_API_KEY=

# Comparative intelligence controls.
COMPARATIVE_SOURCES_PER_QUERY=8

# Deep research controls. Increase rounds/results for a slower, deeper investigation.
DEEP_RESEARCH_ROUNDS=4
DEEP_RESEARCH_RESULTS_PER_QUERY=8
DEEP_RESEARCH_MAX_QUERIES_PER_ROUND=24
DEEP_RESEARCH_FETCH_TIMEOUT_MS=10000
DEEP_RESEARCH_FETCH_LIMIT=120000

# External-service safety timeouts.
LOCATION_PROVIDER_TIMEOUT_MS=12000
SEARCH_PROVIDER_TIMEOUT_MS=20000
AI_PROVIDER_TIMEOUT_MS=45000
GLOBAL_FETCH_TIMEOUT_MS=60000

# Async investigation job retention.
INVESTIGATION_JOB_TTL_MS=21600000

# Evidence graph controls.
GRAPH_RELEVANCE_THRESHOLD=0.28

# Evidence completion / RTI controls.
RTI_STATE=Rajasthan
RTI_VERIFY_AUTHORITY_BEFORE_FILING=true
CROSS_CASE_GRAPH_MAX_CASES=500
